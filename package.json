{
  "name": "lumina-dsh",
  "version": "1.1.3",
  "description": "Lumina — Photoshop automation for DSH: parameterized grading recipes, HDR highlight reconstruction, hot-reloadable style packs, optional super-resolution, auto mode with self-healing, QA metrics and high-resolution vision inspection.",
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "assets/*.py",
    "assets/*.jsx",
    "assets/*.ps1",
    "assets/recipes.json",
    "assets/styles.example.json",
    "assets/config.example.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "icon.svg",
    "docs/images/",
    "test/smoke.mjs",
    "test/integration.mjs",
    "test/acceptance.mjs",
    "CHANGELOG.md",
    "assets/model-catalog.json"
  ],
  "scripts": {
    "test": "node test/smoke.mjs",
    "test:integration": "node test/integration.mjs",
    "test:acceptance": "node test/acceptance.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "photoshop",
    "hdr",
    "tone-mapping",
    "image-grading",
    "color-grading",
    "lut",
    "vision",
    "automation"
  ],
  "author": "Lumina contributors",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}